# AccessFlow Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (for GPT-4o-mini - used for simplification, description, narration)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (optional - for Claude, used as fallback for simplification)
ANTHROPIC_API_KEY=your_anthropic_key_here
